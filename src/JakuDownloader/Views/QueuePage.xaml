<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JakuDownloader.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JakuDownloader.Views.Controls"
    xmlns:vm="using:JakuDownloader.ViewModels">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="16,8,16,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <StackPanel x:Name="ContentPanel" Style="{StaticResource PageContentStyle}">

                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Cola de descargas" />

                <TextBlock
                    Margin="1,-12,0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Queue.Summary, Mode=OneWay}" />

                <!--  Acciones sobre toda la cola  -->
                <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right">
                    <AppBarButton Command="{x:Bind Queue.PauseAllCommand}" Label="Pausar todo">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE769;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind Queue.ResumeAllCommand}" Label="Reanudar todo">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind Queue.CancelAllCommand}" Label="Cancelar todo">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Command="{x:Bind Queue.RemoveFinishedCommand}" Label="Quitar terminadas">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE894;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>

                <TextBlock
                    Margin="1,16,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No hay descargas en esta sesión. Pegá un link en Descargar para empezar."
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Queue.IsEmpty, Mode=OneWay}" />

                <ItemsRepeater Margin="0,8,0,0" ItemsSource="{x:Bind Queue.Items}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DownloadItemViewModel">
                            <controls:DownloadItemView Item="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
