<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="JakuDownloader.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JakuDownloader.Views.Controls"
    xmlns:helpers="using:JakuDownloader.Helpers"
    Title="Jaku Downloader">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Barra de titulo propia: el contenido llega hasta arriba como en las apps de Windows 11  -->
        <Grid
            x:Name="AppTitleBar"
            Padding="16,0,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/AppIcon.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Jaku Downloader" />
        </Grid>

        <!--
            Auto: menu abierto en ventanas anchas y solo iconos en las angostas.
            CompactModeThresholdWidth en 0 evita el modo minimo, que taparia el titulo de la pagina.
        -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="1000"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="240"
            PaneDisplayMode="Auto"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Descargar" Tag="download">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="Cola, próximamente"
                    Tag="queue"
                    ToolTipService.ToolTip="Cola (próximamente)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Cola" />
                        <controls:FeatureBadge IsAvailable="{x:Bind helpers:Features.Queue}" IsCompact="True" Version="v00.06" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="Historial, próximamente"
                    Tag="history"
                    ToolTipService.ToolTip="Historial (próximamente)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Historial" />
                        <controls:FeatureBadge IsAvailable="{x:Bind helpers:Features.Queue}" IsCompact="True" Version="v00.06" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
