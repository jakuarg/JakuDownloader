<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JakuDownloader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JakuDownloader.Views.Controls"
    xmlns:helpers="using:JakuDownloader.Helpers"
    xmlns:models="using:JakuDownloader.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="16,8,16,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <StackPanel x:Name="ContentPanel" Style="{StaticResource PageContentStyle}">

                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Configuración" />

                <InfoBar
                    Title="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                    Margin="0,0,0,8"
                    IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Warning" />

                <InfoBar
                    Title="{x:Bind ViewModel.Tools.InstallResultTitle, Mode=OneWay}"
                    Margin="0,0,0,8"
                    IsOpen="{x:Bind ViewModel.Tools.IsInstallResultOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.Tools.InstallResultMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.Tools.InstallResultSeverity, Mode=OneWay}" />

                <!--  Descargas  -->
                <StackPanel Margin="1,0,0,8" Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Descargas" />
                </StackPanel>

                <toolkit:SettingsCard Description="{x:Bind ViewModel.DownloadDirectory, Mode=OneWay}" Header="Carpeta de destino">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.OpenDownloadFolderCommand}" Content="Abrir" />
                        <Button
                            AutomationProperties.Name="Cambiar la carpeta de destino"
                            Command="{x:Bind ViewModel.ChangeDownloadFolderCommand}"
                            Content="Cambiar..." />
                        <Button
                            AutomationProperties.Name="Volver a la carpeta de destino por defecto"
                            Command="{x:Bind ViewModel.ResetDownloadFolderCommand}"
                            Content="Restablecer"
                            ToolTipService.ToolTip="Volver a Descargas\Jaku Downloader"
                            Visibility="{x:Bind ViewModel.IsCustomDirectory, Mode=OneWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsExpander Description="Cómo se llama cada archivo descargado" Header="Nombre de los archivos">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Stretch"
                            ContentAlignment="Vertical"
                            Header="Plantilla">
                            <StackPanel Spacing="8">
                                <TextBox
                                    AutomationProperties.Name="Plantilla del nombre de los archivos"
                                    FontFamily="Consolas"
                                    Text="{x:Bind ViewModel.TemplateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.TemplateExample, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.IsTemplateValid, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.TemplateError, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.IsTemplateInvalid, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Campos: %(title)s título · %(id)s identificador · %(uploader)s canal · %(upload_date)s fecha · %(height)s alto del video · %(ext)s extensión"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Command="{x:Bind ViewModel.SaveTemplateCommand}"
                                        Content="Guardar"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button Command="{x:Bind ViewModel.ResetTemplateCommand}" Content="Restablecer" />
                                </StackPanel>
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsCard Description="Cuántos videos se bajan al mismo tiempo desde la cola" Header="Descargas simultáneas">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE762;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:FeatureBadge IsAvailable="{x:Bind helpers:Features.Queue}" Version="v00.06" />
                        <NumberBox
                            AutomationProperties.Name="Descargas simultáneas"
                            IsEnabled="{x:Bind helpers:Features.Queue}"
                            Maximum="10"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline"
                            Value="3" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <!--  Herramientas  -->
                <StackPanel Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Herramientas" />
                </StackPanel>

                <toolkit:SettingsExpander
                    Description="{x:Bind ViewModel.Tools.ToolsDirectory, Mode=OneWay}"
                    Header="yt-dlp, FFmpeg y Deno"
                    IsExpanded="True"
                    ItemsSource="{x:Bind ViewModel.Tools.Tools, Mode=OneWay}">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE90F;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <Button Command="{x:Bind ViewModel.Tools.OpenToolsFolderCommand}" Content="Abrir carpeta" />
                    <toolkit:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolInfo">
                            <toolkit:SettingsCard Description="{x:Bind Description}" Header="{x:Bind Name}">
                                <TextBlock
                                    FontFamily="Consolas"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Status}" />
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </toolkit:SettingsExpander.ItemTemplate>
                </toolkit:SettingsExpander>

                <toolkit:SettingsCard Description="{x:Bind ViewModel.Tools.UpdateDescription, Mode=OneWay}" Header="Actualizar yt-dlp">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.Tools.IsUpdating, Mode=OneWay}" />
                        <Button Command="{x:Bind ViewModel.Tools.UpdateYtDlpCommand}" Content="Buscar actualización" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="{x:Bind ViewModel.Tools.InstallDescription, Mode=OneWay}" Header="Descargar herramientas faltantes">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.Tools.IsInstalling, Mode=OneWay}" />
                        <Button Command="{x:Bind ViewModel.Tools.InstallMissingCommand}" Content="Descargar" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <!--  Red  -->
                <StackPanel Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Red" />
                    <controls:FeatureBadge IsAvailable="{x:Bind helpers:Features.Network}" Version="v00.10" />
                </StackPanel>

                <toolkit:SettingsExpander Description="Para videos con restricción de edad o que piden iniciar sesión" Header="Cookies">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Description="Usa la sesión que ya tenés abierta en ese navegador" Header="Tomar cookies del navegador">
                            <ComboBox
                                MinWidth="{StaticResource OptionWidth}"
                                IsEnabled="{x:Bind helpers:Features.Network}"
                                SelectedIndex="0">
                                <x:String>No usar</x:String>
                                <x:String>Chrome</x:String>
                                <x:String>Edge</x:String>
                                <x:String>Firefox</x:String>
                                <x:String>Brave</x:String>
                                <x:String>Opera</x:String>
                                <x:String>Vivaldi</x:String>
                            </ComboBox>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="Archivo cookies.txt en formato Netscape" Header="O usar un archivo de cookies">
                            <Button Content="Elegir archivo..." IsEnabled="{x:Bind helpers:Features.Network}" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsCard Description="Solo las descargas de la app pasan por el proxy (HTTP o SOCKS)" Header="Proxy">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <TextBox
                        MinWidth="260"
                        IsEnabled="{x:Bind helpers:Features.Network}"
                        PlaceholderText="socks5://127.0.0.1:1080" />
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="Para no ocupar toda la conexión mientras se descarga" Header="Límite de velocidad">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEC4A;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch IsEnabled="{x:Bind helpers:Features.Network}" />
                        <NumberBox
                            IsEnabled="{x:Bind helpers:Features.Network}"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            Value="5" />
                        <ComboBox IsEnabled="{x:Bind helpers:Features.Network}" SelectedIndex="1">
                            <x:String>KB/s</x:String>
                            <x:String>MB/s</x:String>
                        </ComboBox>
                    </StackPanel>
                </toolkit:SettingsCard>

                <!--  Acerca de  -->
                <StackPanel Style="{StaticResource SectionHeaderStyle}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Acerca de" />
                </StackPanel>

                <toolkit:SettingsExpander Description="Descargador de audio y video para Windows" Header="Jaku Downloader">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/AppIcon.png" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.AppVersion}" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Description="Código fuente, novedades y reporte de errores" Header="Repositorio en GitHub">
                            <HyperlinkButton Content="github.com/jakuarg/JakuDownloader" NavigateUri="https://github.com/jakuarg/JakuDownloader" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="Hoy solo YouTube. Facebook, X, Instagram y TikTok llegan después de la v01" Header="Sitios compatibles">
                            <controls:FeatureBadge IsAvailable="{x:Bind helpers:Features.OtherSites}" Version="v01.xx" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Left"
                            ContentAlignment="Vertical"
                            Header="Créditos">
                            <StackPanel Spacing="2">
                                <HyperlinkButton Content="yt-dlp (Unlicense)" NavigateUri="https://github.com/yt-dlp/yt-dlp" />
                                <HyperlinkButton Content="FFmpeg (LGPL)" NavigateUri="https://ffmpeg.org" />
                                <HyperlinkButton Content="Deno (MIT)" NavigateUri="https://deno.com" />
                                <HyperlinkButton Content="Windows App SDK (MIT)" NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                                <HyperlinkButton Content="CommunityToolkit (MIT)" NavigateUri="https://github.com/CommunityToolkit" />
                                <HyperlinkButton Content="SponsorBlock (CC BY-NC-SA 4.0)" NavigateUri="https://sponsor.ajay.app" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Left"
                            ContentAlignment="Vertical"
                            Header="Aviso">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Para uso personal y educativo. Respetá los términos de cada sitio y los derechos de autor del contenido que descargás."
                                TextWrapping="Wrap" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
