<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JakuDownloader.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JakuDownloader.Views.Controls"
    xmlns:helpers="using:JakuDownloader.Helpers"
    xmlns:local="using:JakuDownloader.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:JakuDownloader.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!--  Ventana angosta: botones debajo del link y detalles debajo de la etapa  -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="16,8,16,24" />
                        <Setter Target="UrlActions.(Grid.Row)" Value="1" />
                        <Setter Target="UrlActions.(Grid.Column)" Value="0" />
                        <Setter Target="UrlActions.HorizontalAlignment" Value="Right" />
                        <Setter Target="PreviewThumbnail.Visibility" Value="Collapsed" />
                        <Setter Target="PlaylistThumbnail.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <StackPanel x:Name="ContentPanel" Style="{StaticResource PageContentStyle}">

                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Descargar" />

                <!--  Herramientas: aviso si faltan, progreso mientras se instalan y resultado  -->
                <InfoBar
                    Title="Faltan herramientas"
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="{x:Bind Tools.IsMissingBannerOpen, Mode=OneWay}"
                    Message="{x:Bind Tools.MissingToolsMessage, Mode=OneWay}"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button
                            Command="{x:Bind Tools.InstallMissingCommand}"
                            Content="Descargar herramientas"
                            Style="{StaticResource AccentButtonStyle}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    Title="Descargando herramientas"
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="{x:Bind Tools.IsInstalling, Mode=OneWay}"
                    Message="{x:Bind Tools.InstallStatus, Mode=OneWay}"
                    Severity="Informational">
                    <ProgressBar
                        Margin="0,0,0,12"
                        AutomationProperties.Name="Progreso de la descarga de herramientas"
                        Maximum="100"
                        Value="{x:Bind Tools.InstallProgress, Mode=OneWay}" />
                </InfoBar>

                <InfoBar
                    Title="{x:Bind Tools.InstallResultTitle, Mode=OneWay}"
                    Margin="0,0,0,12"
                    IsOpen="{x:Bind Tools.IsInstallResultOpen, Mode=TwoWay}"
                    Message="{x:Bind Tools.InstallResultMessage, Mode=OneWay}"
                    Severity="{x:Bind Tools.InstallResultSeverity, Mode=OneWay}" />

                <!--  Link  -->
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="UrlBox"
                        Header="Link del video"
                        KeyDown="UrlBox_KeyDown"
                        PlaceholderText="https://www.youtube.com/watch?v=..."
                        Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel
                        x:Name="UrlActions"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="PasteButton"
                            AutomationProperties.Name="Pegar el link del portapapeles"
                            Command="{x:Bind ViewModel.PasteCommand}"
                            ToolTipService.ToolTip="Pegar del portapapeles">
                            <FontIcon FontSize="16" Glyph="&#xE77F;" />
                        </Button>

                        <Button
                            x:Name="DownloadButton"
                            MinWidth="120"
                            AutomationProperties.Name="Descargar"
                            Command="{x:Bind ViewModel.DownloadCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Agregar a la cola">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE896;" />
                                <TextBlock Text="Descargar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Destino: la ruta se recorta si no entra; completa en el tooltip y en la ayuda accesible  -->
                <Grid Margin="2,4,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8B7;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Se guarda en" />
                    <HyperlinkButton
                        Grid.Column="2"
                        Padding="4,2"
                        HorizontalAlignment="Left"
                        AutomationProperties.HelpText="{x:Bind ViewModel.DownloadDirectory, Mode=OneWay}"
                        AutomationProperties.Name="Abrir la carpeta de destino"
                        Command="{x:Bind ViewModel.OpenDownloadFolderCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DownloadDirectory, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.DownloadDirectory, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </HyperlinkButton>
                </Grid>

                <!--  Resultado: errores al agregar a la cola y la ultima descarga completa  -->
                <InfoBar
                    Margin="0,12,0,0"
                    IsOpen="{x:Bind ViewModel.IsResultOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.ResultSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            Command="{x:Bind ViewModel.OpenResultFolderCommand}"
                            Content="Abrir carpeta"
                            Visibility="{x:Bind ViewModel.CanOpenResultFolder, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!--  Descargas en curso: las terminadas y canceladas quedan en la Cola  -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Queue.HasActiveItems, Mode=OneWay}">
                    <StackPanel Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Descargas en curso" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Queue.Summary, Mode=OneWay}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Queue.ActiveItems}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <controls:DownloadItemView Item="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!--  Vista previa: aparece al pegar un link valido  -->
                <Border
                    Margin="0,16,0,0"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsPreviewVisible, Mode=OneWay}">
                    <Grid>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.IsPreviewLoading, Mode=OneWay}">
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind ViewModel.IsPreviewLoading, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.PreviewLoadingText, Mode=OneWay}" />
                        </StackPanel>

                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsPreviewFailed, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE946;" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind ViewModel.PreviewMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsVideoPreviewReady, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Dos bordes: el de afuera es el fondo mientras carga, el de adentro recorta la imagen con las esquinas redondeadas  -->
                            <Border
                                x:Name="PreviewThumbnail"
                                Width="192"
                                Height="108"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Border CornerRadius="{StaticResource ControlCornerRadius}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Bind local:BindingFunctions.ToThumbnail(ViewModel.PreviewThumbnailUrl), Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="6">
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.PreviewTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE77B;" />
                                    <TextBlock
                                        AutomationProperties.Name="{x:Bind ViewModel.PreviewChannel, Mode=OneWay}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.PreviewChannel, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE916;" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.PreviewDuration, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!--  Lista o canal: datos, cuantos videos se eligieron y donde se guardan  -->
                        <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsPlaylistPreviewReady, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="PlaylistThumbnail"
                                Width="192"
                                Height="108"
                                VerticalAlignment="Top"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid>
                                    <Border CornerRadius="{StaticResource ControlCornerRadius}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind local:BindingFunctions.ToThumbnail(ViewModel.PlaylistThumbnailUrl), Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border
                                        Padding="6,2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource SmokeFillColorDefaultBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="White"
                                            Glyph="&#xE90B;" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.PlaylistTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.PlaylistSubtitle, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
                                    <Button Click="ChooseVideos_Click" Content="Elegir videos..." />
                                </StackPanel>
                                <ToggleSwitch
                                    Header="Guardar en una carpeta con el nombre de la lista"
                                    IsOn="{x:Bind ViewModel.SaveInPlaylistFolder, Mode=TwoWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.PlaylistFolderHint, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Video abierto desde una lista: elegir si se baja solo o con toda la lista  -->
                <toolkit:SettingsCard
                    Margin="0,8,0,0"
                    Description="Por defecto se baja solo este video"
                    Header="Este video es parte de una lista"
                    Visibility="{x:Bind ViewModel.IsVideoInPlaylist, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE90B;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        AutomationProperties.Name="Bajar la lista completa"
                        IsOn="{x:Bind ViewModel.DownloadWholePlaylist, Mode=TwoWay}"
                        OffContent="Solo este video"
                        OnContent="Bajar la lista completa" />
                </toolkit:SettingsCard>

                <!--  Opciones de la descarga  -->
                <toolkit:SettingsCard
                    Margin="0,8,0,0"
                    Description="Video con audio, o solo el audio"
                    Header="Tipo de descarga">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B2;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="{StaticResource OptionWidth}"
                        AutomationProperties.Name="Tipo de descarga"
                        SelectedIndex="{x:Bind ViewModel.MediaKindIndex, Mode=TwoWay}">
                        <x:String>Video</x:String>
                        <x:String>Solo audio</x:String>
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Description="Tipo de archivo que se guarda" Header="Formato">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Grid>
                        <ComboBox
                            MinWidth="{StaticResource OptionWidth}"
                            AutomationProperties.Name="Formato de video"
                            SelectedIndex="{x:Bind ViewModel.VideoFormatIndex, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay}">
                            <x:String>MP4 (se reproduce en todos lados)</x:String>
                            <x:String>MKV (admite cualquier códec)</x:String>
                            <x:String>WebM (VP9 + Opus)</x:String>
                        </ComboBox>
                        <ComboBox
                            MinWidth="{StaticResource OptionWidth}"
                            AutomationProperties.Name="Formato de audio"
                            SelectedIndex="{x:Bind ViewModel.AudioFormatIndex, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsAudio, Mode=OneWay}">
                            <x:String>MP3</x:String>
                            <x:String>M4A (AAC original, sin recomprimir)</x:String>
                            <x:String>Opus (original, sin recomprimir)</x:String>
                            <x:String>FLAC (sin pérdida)</x:String>
                            <x:String>WAV (sin comprimir)</x:String>
                        </ComboBox>
                    </Grid>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Description="Resolución máxima del video"
                    Header="Calidad"
                    Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="{StaticResource OptionWidth}"
                        AutomationProperties.Name="Calidad"
                        SelectedIndex="{x:Bind ViewModel.ResolutionIndex, Mode=TwoWay}">
                        <x:String>La mejor disponible</x:String>
                        <x:String>Hasta 2160p (4K)</x:String>
                        <x:String>Hasta 1440p (2K)</x:String>
                        <x:String>Hasta 1080p (Full HD)</x:String>
                        <x:String>Hasta 720p (HD)</x:String>
                        <x:String>Hasta 480p</x:String>
                        <x:String>Hasta 360p</x:String>
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsExpander
                    Description="{x:Bind ViewModel.CodecsDescription, Mode=OneWay}"
                    Header="Códecs"
                    Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay}">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Description="Automático elige H.264 cuando la resolución lo permite" Header="Códec de video">
                            <ComboBox
                                MinWidth="{StaticResource OptionWidth}"
                                AutomationProperties.Name="Códec de video"
                                IsEnabled="{x:Bind ViewModel.AreCodecOptionsEnabled, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.VideoCodecIndex, Mode=TwoWay}">
                                <x:String>Automático</x:String>
                                <x:String>H.264 (AVC)</x:String>
                                <x:String>VP9</x:String>
                                <x:String>AV1</x:String>
                            </ComboBox>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="Automático elige AAC" Header="Códec de audio">
                            <ComboBox
                                MinWidth="{StaticResource OptionWidth}"
                                AutomationProperties.Name="Códec de audio"
                                IsEnabled="{x:Bind ViewModel.AreCodecOptionsEnabled, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.AudioCodecIndex, Mode=TwoWay}">
                                <x:String>Automático</x:String>
                                <x:String>AAC</x:String>
                                <x:String>Opus</x:String>
                            </ComboBox>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander Description="Subtítulos, capítulos, portada y metadatos" Header="Subtítulos y capítulos">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7F0;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            Description="Solo en descargas de video"
                            Header="Descargar subtítulos"
                            Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay}">
                            <ToggleSwitch AutomationProperties.Name="Descargar subtítulos" IsOn="{x:Bind ViewModel.DownloadSubtitles, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            Description="Códigos exactos separados por coma, por ejemplo es, en o es-419"
                            Header="Idiomas"
                            Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBox
                                    MinWidth="{StaticResource OptionWidth}"
                                    AutomationProperties.Name="Idiomas de los subtítulos"
                                    IsEnabled="{x:Bind ViewModel.DownloadSubtitles, Mode=OneWay}"
                                    PlaceholderText="es, en"
                                    Text="{x:Bind ViewModel.SubtitleLanguagesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    MaxWidth="260"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SubtitleLanguagesError, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasSubtitleLanguagesError, Mode=OneWay}" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            Description="Los que genera YouTube cuando el video no tiene subtítulos hechos a mano"
                            Header="Incluir subtítulos automáticos"
                            Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay}">
                            <ToggleSwitch
                                AutomationProperties.Name="Incluir subtítulos automáticos"
                                IsEnabled="{x:Bind ViewModel.DownloadSubtitles, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.AutomaticSubtitles, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            Description="Quedan dentro del video. Si está apagado, se guardan como archivos .srt al lado"
                            Header="Incrustar subtítulos"
                            Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay}">
                            <ToggleSwitch
                                AutomationProperties.Name="Incrustar subtítulos"
                                IsEnabled="{x:Bind ViewModel.DownloadSubtitles, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.EmbedSubtitles, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="Para saltar entre partes desde el reproductor, si el video los tiene" Header="Incrustar capítulos">
                            <ToggleSwitch AutomationProperties.Name="Incrustar capítulos" IsOn="{x:Bind ViewModel.EmbedChapters, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="{x:Bind ViewModel.ThumbnailDescription, Mode=OneWay}" Header="Incrustar portada y metadatos">
                            <ToggleSwitch AutomationProperties.Name="Incrustar portada y metadatos" IsOn="{x:Bind ViewModel.EmbedMetadata, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander Description="{x:Bind ViewModel.SponsorBlockDescription, Mode=OneWay}" Header="SponsorBlock">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7C1;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <ComboBox
                        MinWidth="{StaticResource OptionWidth}"
                        AutomationProperties.Name="Qué hacer con los segmentos patrocinados"
                        SelectedIndex="{x:Bind ViewModel.SponsorBlockModeIndex, Mode=TwoWay}">
                        <x:String>No hacer nada</x:String>
                        <x:String>Marcarlos como capítulos</x:String>
                        <x:String>Quitarlos del archivo</x:String>
                    </ComboBox>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Left"
                            ContentAlignment="Vertical"
                            Description="Los segmentos los marca la comunidad de SponsorBlock: no todos los videos los tienen"
                            Header="Categorías">
                            <StackPanel Spacing="8">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SponsorBlockCategories}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="220" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SponsorBlockCategoryViewModel">
                                            <CheckBox
                                                Content="{x:Bind Label}"
                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SponsorBlockError, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasSponsorBlockError, Mode=OneWay}" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </ScrollViewer>

        <!--  Elegir que videos de la lista bajar  -->
        <ContentDialog
            x:Name="ChooseVideosDialog"
            CloseButtonText="Listo"
            DefaultButton="Close"
            Title="Elegir videos">
            <Grid Width="520" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.SelectAllEntriesCommand}"
                        Content="Todos" />
                    <Button
                        Grid.Column="2"
                        Command="{x:Bind ViewModel.SelectNoEntriesCommand}"
                        Content="Ninguno" />
                </Grid>
                <ListView
                    Grid.Row="1"
                    Height="420"
                    AutomationProperties.Name="Videos de la lista"
                    ItemsSource="{x:Bind ViewModel.PlaylistEntries}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaylistEntryViewModel">
                            <CheckBox
                                Padding="8,4,0,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind Title}"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind DurationText}" />
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
