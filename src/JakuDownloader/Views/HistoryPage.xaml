<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JakuDownloader.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JakuDownloader.Views"
    xmlns:vm="using:JakuDownloader.ViewModels">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentPanel.Padding" Value="16,8,16,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <StackPanel x:Name="ContentPanel" Style="{StaticResource PageContentStyle}">

                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Historial" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="400" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        AutomationProperties.Name="Buscar en el historial"
                        IsEnabled="{x:Bind ViewModel.HasEntries, Mode=OneWay}"
                        PlaceholderText="Buscar por título o canal"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                    <Button
                        Grid.Column="2"
                        Click="ClearHistory_Click"
                        IsEnabled="{x:Bind ViewModel.HasEntries, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                            <TextBlock Text="Borrar historial" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar
                    Margin="0,12,0,0"
                    IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                    Severity="Informational" />

                <TextBlock
                    Margin="1,16,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

                <ItemsRepeater Margin="0,12,0,0" ItemsSource="{x:Bind ViewModel.Items}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                            <Border Padding="12" Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="112"
                                        Height="63"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <Border CornerRadius="{StaticResource ControlCornerRadius}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind local:BindingFunctions.ToThumbnail(ThumbnailUrl)}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Subtitle}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="El archivo ya no está en su carpeta"
                                            Visibility="{x:Bind FileMissing}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Button
                                            AutomationProperties.Name="Abrir"
                                            Command="{x:Bind OpenCommand}"
                                            IsEnabled="{x:Bind FileExists}"
                                            ToolTipService.ToolTip="Abrir">
                                            <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Mostrar en la carpeta"
                                            Command="{x:Bind ShowInFolderCommand}"
                                            ToolTipService.ToolTip="Mostrar en la carpeta">
                                            <FontIcon FontSize="16" Glyph="&#xE838;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Descargar de nuevo"
                                            Command="{x:Bind RedownloadCommand}"
                                            ToolTipService.ToolTip="Descargar de nuevo con las mismas opciones">
                                            <FontIcon FontSize="16" Glyph="&#xE896;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Quitar del historial"
                                            Command="{x:Bind RemoveCommand}"
                                            ToolTipService.ToolTip="Quitar del historial (no borra el archivo)">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
